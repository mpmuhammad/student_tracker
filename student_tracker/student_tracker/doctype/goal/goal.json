{
  "doctype": "DocType",
  "name": "Goal",
  "module": "Student Tracker",
  "autoname": "hash",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "student",
    "task_description",
    "goal_term",
    "status",
    "actual_percentage",
    "created_on",
    "closed_on",
    "is_closed"
  ],
  "fields": [
    {
      "fieldname": "student",
      "fieldtype": "Link",
      "label": "Student",
      "options": "Student",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "task_description",
      "fieldtype": "Small Text",
      "label": "Task Description",
      "reqd": 1
    },
    {
      "fieldname": "goal_term",
      "fieldtype": "Select",
      "label": "Goal Term",
      "options": "Short Term\nLong Term",
      "default": "Short Term",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Started\nOngoing\nComplete",
      "default": "Started",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "actual_percentage",
      "fieldtype": "Int",
      "label": "Actual Percentage",
      "default": 0,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "created_on",
      "fieldtype": "Datetime",
      "label": "Created On",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "closed_on",
      "fieldtype": "Datetime",
      "label": "Closed On",
      "read_only": 1
    },
    {
      "fieldname": "is_closed",
      "fieldtype": "Check",
      "label": "Closed",
      "default": "0",
      "read_only": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Mentor",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}